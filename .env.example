INSTAGRAM_USER_ID=

# Stripe Secret Key (Optional - for US/Global & Japan checkout)
STRIPE_SECRET_KEY=

# PayPal Credentials (Optional - for PayPal checkout)
PAYPAL_CLIENT_ID=
